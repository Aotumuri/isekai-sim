diff --git a/src/sim/war-campaign/recruitment-fuel-budget.ts b/src/sim/war-campaign/recruitment-fuel-budget.ts
new file mode 100644
index 0000000..0049c7c
--- /dev/null
+++ b/src/sim/war-campaign/recruitment-fuel-budget.ts
@@ -0,0 +1,16 @@
+import type { NationId } from "../../worldgen/nation";
+import type { WorldState } from "../world-state";
+import { getManualGovernmentId } from "../player-nation";
+import { getWarCampaign } from "./state";
+
+/** One next-production-pass projection using this pass's observed income.
+ * Existing upkeep is paid first; callers debit newly committed land upkeep.
+ * This is not a stock reservation or a guarantee of future fuel deliveries. */
+export function getCampaignRecruitmentFuelBudget(
+  world: WorldState, nationId: NationId, remainingFuel: number,
+  fuelIncome: number, existingUpkeep: number,
+): number {
+  if (!getWarCampaign(world, nationId) || getManualGovernmentId(world) === nationId) return Infinity;
+  if (![remainingFuel, fuelIncome, existingUpkeep].every(Number.isFinite)) return 0;
+  return Math.max(0, remainingFuel + fuelIncome - existingUpkeep);
+}
diff --git a/test/regression/war-campaign-recruitment-fuel.test.ts b/test/regression/war-campaign-recruitment-fuel.test.ts
new file mode 100644
index 0000000..6c44519
--- /dev/null
+++ b/test/regression/war-campaign-recruitment-fuel.test.ts
@@ -0,0 +1,93 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { createScenarioWorld } from "../scenarios";
+import { updateProduction } from "../../src/sim/production";
+import { updateWarCampaigns } from "../../src/sim/war-campaign/update";
+import { getCampaignRecruitmentFuelBudget } from "../../src/sim/war-campaign/recruitment-fuel-budget";
+import { updateSupplyAssessment } from "../../src/sim/supply-assessment";
+import { enterPlayerNation } from "../../src/sim/player-nation";
+import { getNationalDesign, getResearchPortfolio } from "../../src/sim/research";
+import { WORLD_BALANCE } from "../../src/data/balance";
+
+function recruitmentWorld() {
+  const world = createScenarioWorld("active-war", { seed: 822748319780, quick: true, width: 640, height: 360 });
+  world.settings!.warCampaignEnabled = true;
+  world.settings!.mobilizationEnabled = false;
+  updateWarCampaigns(world);
+  const nation = world.nations.find((n) => world.warCampaigns!.byNationId.has(n.id))!;
+  assert.ok(nation);
+  world.units = [];
+  for (const region of world.mesoRegions) region.resource = null;
+  for (const n of world.nations) n.nextUnitProductionTick = Infinity;
+  nation.nextUnitProductionTick = 0;
+  Object.assign(nation.resources, { weapons: 1000, manpower: 100000, fuel: 0,
+    steel: 1000, copper: 1000, rubber: 1000, tungsten: 1000 });
+  world.simRng.nextFloat = () => 0;
+  updateSupplyAssessment(world);
+  return { world, nation };
+}
+
+test("wartime recruitment replaces fuel-disabled tanks with usable infantry", () => {
+  const { world, nation } = recruitmentWorld();
+  updateProduction(world);
+  const recruits = world.units.filter((u) => u.nationId === nation.id && u.domain === "land");
+  assert.ok(recruits.length > 0);
+  assert.ok(recruits.every((u) => u.type === "Infantry" && u.combatPower > 0));
+});
+
+test("disabled and manual governments retain ordinary tank selection", () => {
+  for (const mode of ["disabled", "manual"] as const) {
+    const { world, nation } = recruitmentWorld();
+    if (mode === "disabled") world.settings!.warCampaignEnabled = false;
+    else assert.equal(enterPlayerNation(world, nation.id), true);
+    updateProduction(world);
+    const recruits = world.units.filter((u) => u.nationId === nation.id && u.domain === "land");
+    assert.ok(recruits.length > 0);
+    assert.ok(recruits.every((u) => u.type === "Tank"));
+    assert.equal(world.playerNation?.landOrders.size ?? 0, 0);
+  }
+});
+
+test("available fuel permits the original tank choice", () => {
+  const { world, nation } = recruitmentWorld();
+  nation.resources.fuel = 10000;
+  updateProduction(world);
+  const recruits = world.units.filter((u) => u.nationId === nation.id && u.domain === "land");
+  assert.ok(recruits.length > 0);
+  assert.ok(recruits.every((u) => u.type === "Tank" && u.combatPower > 0));
+});
+
+test("one-pass fuel budget pays existing upkeep before extra recruitment", () => {
+  const { world, nation } = recruitmentWorld();
+  assert.equal(getCampaignRecruitmentFuelBudget(world, nation.id, 2, 4, 3), 3);
+  assert.equal(getCampaignRecruitmentFuelBudget(world, nation.id, 0, 4, 5), 0);
+  assert.equal(getCampaignRecruitmentFuelBudget(world, nation.id, NaN, 4, 0), 0);
+  world.warCampaigns!.byNationId.delete(nation.id);
+  assert.equal(getCampaignRecruitmentFuelBudget(world, nation.id, 0, 0, 0), Infinity);
+});
+
+test("a recruitment batch cannot spend one tank's design-adjusted fuel twice", () => {
+  const { world, nation } = recruitmentWorld();
+  getResearchPortfolio(world, nation.id, "Tank").levels.fuel = 10;
+  const design = getNationalDesign(world, nation.id, "Tank");
+  assert.ok(design.fuelUse < 1);
+  nation.resources.fuel = WORLD_BALANCE.unit.types.Tank.fuelUse * design.fuelUse;
+  updateProduction(world);
+  const recruits = world.units.filter((u) => u.nationId === nation.id && u.domain === "land");
+  assert.ok(recruits.length > 1, "fixture must exercise a batch");
+  assert.equal(recruits.filter((u) => u.type === "Tank").length, 1);
+  assert.ok(recruits.slice(1).every((u) => u.type === "Infantry"));
+});
+
+test("substituting an unaffordable operating type preserves ordinary choice draws", () => {
+  const results = [true, false].map((enabled) => {
+    const { world, nation } = recruitmentWorld();
+    world.settings!.warCampaignEnabled = enabled;
+    let draws = 0;
+    world.simRng.nextFloat = () => { draws++; return 0; };
+    updateProduction(world);
+    return { draws, units: world.units.filter((u) => u.nationId === nation.id).length };
+  });
+  assert.deepEqual(results[0], results[1]);
+  assert.ok(results[0].draws > 0);
+});
