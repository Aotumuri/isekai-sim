@@ -0,0 +1,88 @@
+import { WORLD_BALANCE } from "../data/balance";
+import type { NationId } from "../worldgen/nation";
+import type { CapitalDefenseAssessment } from "./capital-defense";
+import { getOpposingFrontSide } from "./land-fronts";
+import { isNationActive } from "./nation-active";
+import { getUnitEquipmentFulfillment, getUnitManpowerRatio } from "./reorganization";
+import type { UnitId, UnitState } from "./unit";
+import { getUnitCombatStrength } from "./unit-strength";
+import { getOwnerByMesoId } from "./world-cache";
+import type { WorldState } from "./world-state";
+
+export function updateCapitalGuards(world: WorldState): void {
+  const previous = world.capitalDefense.guardByNationId;
+  if (!world.settings?.warCampaignEnabled && !previous.size) return;
+  const next = new Map<NationId, UnitId>();
+  for (const assessment of world.capitalDefense.assessments) {
+    if (!canGuardCapital(world, assessment)) continue;
+    const guard = chooseCapitalGuard(world, assessment, previous.get(assessment.nationId));
+    if (guard) next.set(assessment.nationId, guard.id);
+  }
+  if (next.size !== previous.size || [...next].some(([nationId, id]) => previous.get(nationId) !== id)) {
+    world.capitalDefense.guardByNationId = next;
+  }
+}
+
+export function pruneCapitalGuards(world: WorldState, landUnits: UnitState[]): void {
+  const previous = world.capitalDefense.guardByNationId;
+  if (!previous.size) return;
+  const next = new Map<NationId, UnitId>();
+  for (const unit of landUnits) {
+    if (isCapitalGuard(world, unit)) next.set(unit.nationId, unit.id);
+  }
+  if (next.size !== previous.size) world.capitalDefense.guardByNationId = next;
+}
+
+export function isCapitalGuard(world: WorldState, unit: UnitState): boolean {
+  if (world.capitalDefense.guardByNationId.get(unit.nationId) !== unit.id) return false;
+  const assessment = world.capitalDefense.assessmentsByNationId.get(unit.nationId);
+  return !!assessment && canGuardCapital(world, assessment) && canHoldCapital(world, assessment, unit);
+}
+
+export function getCapitalGuardDefenseStrength(world: WorldState, nationId: NationId, opponentId: NationId, units: UnitState[]): number {
+  const id = world.capitalDefense.guardByNationId.get(nationId);
+  if (!id) return 0;
+  const guard = units.find((unit) => unit.id === id);
+  const assessment = world.capitalDefense.assessmentsByNationId.get(nationId);
+  if (!guard || !assessment || !isCapitalGuard(world, guard)) return 0;
+  const threatensCapital = assessment.threatenedFrontIds.some((frontId) => {
+    const front = world.landFronts.operationalSectorsById.get(frontId);
+    return front && getOpposingFrontSide(front, nationId)?.nationId === opponentId;
+  }) || world.units.some((unit) => unit.nationId === opponentId && assessment.enemyUnitIds.includes(unit.id));
+  return threatensCapital ? getUnitCombatStrength(guard) : 0;
+}
+
+function canGuardCapital(world: WorldState, assessment: CapitalDefenseAssessment): boolean {
+  const { nationId, capitalRegionId, threatLevel } = assessment;
+  return !!world.settings?.warCampaignEnabled && threatLevel !== "none" &&
+    world.playerNation?.nationId !== nationId &&
+    world.nations.some((nation) => nation.id === nationId && isNationActive(nation) && nation.capitalMesoId === capitalRegionId) &&
+    world.wars.some((war) => war.nationAId === nationId || war.nationBId === nationId) &&
+    getOwnerByMesoId(world).get(capitalRegionId) === nationId && !world.occupation.mesoById.has(capitalRegionId);
+}
+
+function chooseCapitalGuard(world: WorldState, assessment: CapitalDefenseAssessment, previousId?: UnitId): UnitState | undefined {
+  let strongest: UnitState | undefined;
+  let strength = 0;
+  for (const unit of world.units) {
+    if (!canHoldCapital(world, assessment, unit)) continue;
+    if (unit.id === previousId) return unit;
+    const candidate = getUnitCombatStrength(unit);
+    if (!strongest || candidate > strength || (candidate === strength && unit.id < strongest.id)) {
+      strongest = unit;
+      strength = candidate;
+    }
+  }
+  return strongest;
+}
+
+function canHoldCapital(world: WorldState, assessment: CapitalDefenseAssessment, unit: UnitState): boolean {
+  const recovery = WORLD_BALANCE.war.landFront.reorganization;
+  return unit.domain === "land" && unit.nationId === assessment.nationId && unit.regionId === assessment.capitalRegionId &&
+    unit.org >= recovery.organizationStartRatio && getUnitManpowerRatio(unit) >= recovery.manpowerStartRatio &&
+    getUnitEquipmentFulfillment(unit) >= recovery.equipmentStartRatio && getUnitCombatStrength(unit) > 0 &&
+    !world.retreatPlans.retreatIdByUnitId.has(unit.id) && !world.reorganization.planIdByUnitId.has(unit.id) &&
+    !world.strategicReserves.reserveNationByUnitId.has(unit.id) && !world.offensiveOperations.operationIdByUnitId.has(unit.id) &&
+    !world.amphibiousOperations.operationByUnitId.has(unit.id) && !world.amphibiousOperations.capabilityDemandByUnitId.has(unit.id) &&
+    !world.collapseAdvances.advanceNationByUnitId.has(unit.id) && !world.militaryAccess?.orders.has(unit.id);
+}
