@@ -0,0 +1,103 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { updateCapitalDefense } from "../../src/sim/capital-defense";
+import { repositionUnits } from "../../src/sim/nation/reposition-units";
+import { issuePlayerLandOrder, setPlayerCommandMode } from "../../src/sim/player-land-orders";
+import { enterPlayerNation } from "../../src/sim/player-nation";
+import { assignUnitToStrategicReserve } from "../../src/sim/strategic-reserves";
+import { createScenarioWorld } from "../scenarios";
+
+function threatenedCapital(enabled = true) {
+  const world = createScenarioWorld("stalemate-breaker", {
+    seed: 1022748319780, width: 640, height: 360, quick: true,
+  });
+  world.settings!.warCampaignEnabled = enabled;
+  const unit = world.units.find((candidate) => candidate.id === "unit-90")!;
+  const nation = world.nations.find((candidate) => candidate.id === unit.nationId)!;
+  const capital = nation.capitalMesoId;
+  assert.equal(unit.regionId, capital);
+  return { world, unit, nation, capital };
+}
+
+test("the existing effective guard stays on its threatened capital while other units march", () => {
+  const { world, unit, capital } = threatenedCapital();
+  // Warm the movement cache while the selected unit is already bound for the front.
+  repositionUnits(world, 0);
+  const departedTarget = unit.moveTargetId;
+  assert.ok(departedTarget && departedTarget !== capital);
+  updateCapitalDefense(world);
+  repositionUnits(world, 100);
+  assert.equal(unit.moveTargetId, null, "the standing guard's old order is cleared immediately");
+  assert.equal(unit.moveToId, null);
+  assert.equal(unit.regionId, capital);
+  assert(world.units.some((other) => other.id !== unit.id && other.nationId === unit.nationId &&
+    other.moveTargetId && other.moveTargetId !== other.regionId));
+  assert.equal(assignUnitToStrategicReserve(world, unit.id), false);
+  assert.equal(world.capitalDefense.guardByNationId.get(unit.nationId), unit.id);
+});
+
+test("disabled movement follows the normal orders and manual control releases an active reservation", () => {
+  const disabled = threatenedCapital(false);
+  updateCapitalDefense(disabled.world);
+  repositionUnits(disabled.world, 0);
+  const target = disabled.unit.moveTargetId;
+  assert.ok(target && target !== disabled.capital);
+  assert.equal(disabled.world.capitalDefense.guardByNationId.size, 0);
+
+  const { world, unit } = threatenedCapital();
+  updateCapitalDefense(world);
+  repositionUnits(world, 0);
+  assert.equal(unit.moveTargetId, null);
+  assert(enterPlayerNation(world, unit.nationId));
+  setPlayerCommandMode(world, "manual");
+  assert.equal(issuePlayerLandOrder(world, target, unit.id), 1);
+  repositionUnits(world, 100);
+  assert.equal(unit.moveTargetId, target);
+  assert.equal(world.capitalDefense.guardByNationId.has(unit.nationId), false);
+});
+
+test("guard reservations yield to established missions and clear on invalidation", () => {
+  const cases = {
+    operation: ({ world, unit }: ReturnType<typeof threatenedCapital>) => {
+      world.offensiveOperations.operationIdByUnitId.set(unit.id, "operation-test" as never);
+    },
+    reorganization: ({ world, unit }: ReturnType<typeof threatenedCapital>) => {
+      world.reorganization.planIdByUnitId.set(unit.id, "reorganization-test" as never);
+    },
+    noThreat: ({ world, nation }: ReturnType<typeof threatenedCapital>) => {
+      world.capitalDefense.assessmentsByNationId.get(nation.id)!.threatLevel = "none";
+    },
+    peace: ({ world }: ReturnType<typeof threatenedCapital>) => { world.wars = []; },
+    capitalMoved: ({ world, nation, capital }: ReturnType<typeof threatenedCapital>) => {
+      nation.capitalMesoId = world.mesoRegions.find((region) => region.id !== capital)!.id;
+    },
+    occupation: ({ world, nation, capital }: ReturnType<typeof threatenedCapital>) => {
+      world.occupation.mesoById.set(capital, world.nations.find((other) => other !== nation)!.id);
+    },
+    depleted: ({ unit }: ReturnType<typeof threatenedCapital>) => { unit.org = 0; },
+    removed: ({ world }: ReturnType<typeof threatenedCapital>) => { world.units = []; },
+    disabled: ({ world }: ReturnType<typeof threatenedCapital>) => { world.settings!.warCampaignEnabled = false; },
+  };
+  for (const [reason, invalidate] of Object.entries(cases)) {
+    const fixture = threatenedCapital();
+    const { world, unit } = fixture;
+    updateCapitalDefense(world);
+    assert.equal(world.capitalDefense.guardByNationId.get(unit.nationId), unit.id, reason);
+    invalidate(fixture);
+    repositionUnits(world, 0);
+    assert.equal(world.capitalDefense.guardByNationId.has(unit.nationId), false, reason);
+  }
+});
+
+test("equally effective eligible guards are selected independently of unit iteration order", () => {
+  const choose = (reverse: boolean) => {
+    const { world, unit } = threatenedCapital();
+    const other = world.units.find((candidate) => candidate.id === "unit-85")!;
+    Object.assign(other, unit, { id: other.id });
+    if (reverse) world.units.reverse();
+    updateCapitalDefense(world);
+    return world.capitalDefense.guardByNationId.get(unit.nationId);
+  };
+  assert.equal(choose(false), "unit-85");
+  assert.equal(choose(true), "unit-85");
+});
