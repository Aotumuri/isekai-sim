+
+test("a nation needs an active defensive war for the role control to reserve its guard", () => {
+  const { world, unit, nation } = threatenedCapital();
+  const defensiveWar = world.wars[0];
+  assert.equal(defensiveWar.defenderId, nation.id);
+  const other = world.nations.find((candidate) =>
+    candidate.id !== nation.id && candidate.id !== defensiveWar.aggressorId)!;
+  assert(declareWar(world.wars, nation.id, other.id, world.time.fastTick));
+  updateCapitalDefense(world);
+  assert.equal(world.capitalDefense.guardByNationId.get(nation.id), unit.id);
+
+  world.wars = world.wars.filter((war) => war !== defensiveWar);
+  repositionUnits(world, 0);
+  assert.equal(world.capitalDefense.guardByNationId.has(nation.id), false);
+  updateCapitalDefense(world);
+  assert.equal(world.capitalDefense.guardByNationId.has(nation.id), false);
+});
