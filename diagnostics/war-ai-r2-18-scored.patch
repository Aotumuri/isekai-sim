+
+test("early strategic focus keeps ordinary operation size until natural pressure takes over", () => {
+  const { world, nation, opponent } = fixture();
+  updateStalematePressure(world);
+  const focus = getStalemateAssessment(world, nation, opponent)!;
+  const front = focus.schwerpunktSectorId!;
+  assert.ok(front);
+  assert.equal(focus.campaignRequested, true);
+  assert.equal(campaignOperationForceFraction(world, nation, front, true),
+    WORLD_BALANCE.war.landFront.offensiveOperation.forceFraction);
+  focus.pressure = WORLD_BALANCE.war.landFront.stalemate.maximumPressure;
+  updateStalematePressure(world);
+  assert.equal(getStalemateAssessment(world, nation, opponent)!.campaignRequested, false);
+  assert.equal(campaignOperationForceFraction(world, nation, front, true),
+    WORLD_BALANCE.war.landFront.stalemate.majorOperationForceFraction);
+});
+
+test("disabled campaigns ignore stale early-focus sizing and ordinary fronts retain their share", () => {
+  const { world, nation, opponent } = fixture();
+  updateStalematePressure(world);
+  const front = getStalemateAssessment(world, nation, opponent)!.schwerpunktSectorId!;
+  assert.equal(campaignOperationForceFraction(world, nation, front, false),
+    WORLD_BALANCE.war.landFront.offensiveOperation.forceFraction);
+  world.settings!.warCampaignEnabled = false;
+  assert.equal(campaignOperationForceFraction(world, nation, front, true),
+    WORLD_BALANCE.war.landFront.stalemate.majorOperationForceFraction);
+});
diff --git a/test/regression/campaign-operation-size.test.ts b/test/regression/campaign-operation-size.test.ts
new file mode 100644
index 0000000..62cc505
--- /dev/null
+++ b/test/regression/campaign-operation-size.test.ts
@@ -0,0 +1,35 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createScenarioWorld } from "../scenarios";
+import { runSimulation } from "../helpers/simulation-driver";
+import { BenchmarkMetrics } from "../benchmark/metrics";
+import { withMutedSimulationLogs } from "../helpers/muted-logs";
+import { WORLD_BALANCE } from "../../src/data/balance";
+
+test("early national concentration creates a focused ordinary-size operation through the real planner", () => {
+  const world = createScenarioWorld("stalemate-breaker", {
+    seed: 822748319794, quick: true, width: 640, height: 360,
+    config: { systems: { warCampaignEnabled: true } },
+  });
+  const attacker = world.wars[0].aggressorId;
+  class EarlyFocusMetrics extends BenchmarkMetrics {
+    override recordDuration(name: string, ms: number) {
+      super.recordDuration(name, ms);
+      if (name !== "warCampaign.evaluation") return;
+      // Hold the national decision fixed; test the downstream allocation and
+      // operation planner, without changing local eligibility or unit orders.
+      const campaign = world.warCampaigns!.byNationId.get(attacker)!;
+      campaign.mode = "limited-offensive";
+      campaign.militaryMode = "limited-offensive";
+    }
+  }
+  withMutedSimulationLogs(() => runSimulation(world, { ticks: 10, metrics: new EarlyFocusMetrics() }));
+  const operation = world.offensiveOperations.operations.find((op) => op.nationId === attacker);
+  assert.ok(operation, "the locally eligible operation must still launch preparation");
+  assert.equal(operation.isSchwerpunktOperation, true);
+  assert.equal(operation.isMajorOffensive, false);
+  const requested = [...operation.plannedStrengthByApproach.values()].reduce((sum, n) => sum + n, 0);
+  assert.ok(Math.abs(requested - operation.offensiveSurplusAvailable *
+    WORLD_BALANCE.war.landFront.offensiveOperation.forceFraction) < 1e-6,
+    "early focus must preserve ordinary requested force before discrete unit assignment");
+});
