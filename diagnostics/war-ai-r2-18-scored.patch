+import { WORLD_BALANCE } from "../../data/balance";
+import type { FrontId } from "../land-fronts";
 import type { NationId } from "../../worldgen/nation";
 import type { NationFrontPlan } from "../nation-front-plans";
 import type { WorldState } from "../world-state";
@@ -10,3 +12,15 @@ export function campaignOperationRank(world: WorldState, nationId: NationId, pla
   if (!campaign || !plan.reasonFlags.includes("campaign-primary")) return 0;
   return plan.reasonFlags.includes("declared-war-objective") ? 2 : 1;
 }
+
+/** Early strategic focus prioritizes a front without itself authorizing the
+ * larger mature-focus operation share. Natural focus keeps its existing size. */
+export function campaignOperationForceFraction(
+  world: WorldState, nationId: NationId, frontId: FrontId, focused: boolean,
+): number {
+  const ordinary = WORLD_BALANCE.war.landFront.offensiveOperation.forceFraction;
+  if (!focused) return ordinary;
+  const early = getWarCampaign(world, nationId) && world.stalematePressure.assessments.some((assessment) =>
+    assessment.nationId === nationId && assessment.schwerpunktSectorId === frontId && assessment.campaignRequested);
+  return early ? ordinary : WORLD_BALANCE.war.landFront.stalemate.majorOperationForceFraction;
+}
