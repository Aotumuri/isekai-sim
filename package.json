{
  "name": "isekai-sim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:typecheck && node --import tsx --test test/regression/*.test.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "test:typecheck": "tsc -p tsconfig.test.json",
    "test:sim": "node --import tsx --test test/regression/simulation.test.ts",
    "benchmark": "node --import tsx test/benchmark/run-benchmark.ts",
    "benchmark:quick": "node --import tsx test/benchmark/run-benchmark.ts --quick",
    "benchmark:compare": "node --import tsx test/benchmark/compare-results.ts",
    "diagnostic:two-island": "node --import tsx test/diagnostics/two-island-campaign.ts"
  },
  "dependencies": {
    "d3-delaunay": "^6.0.4",
    "pixi.js": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.10",
    "typescript": "^5.4.5",
    "vite": "^5.4.11"
  }
}
